generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  TRIAL
  PRO
}

enum ObraStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum EtapaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
}

enum MaterialCategoria {
  CIMENTO
  AREIA
  BRITA
  TIJOLO
  FERRO
  MADEIRA
  ELETRICA
  HIDRAULICA
  ACABAMENTO
  OUTROS
}

// ─── Auth.js Models ───────────────────────────────────────

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String    @unique
  emailVerified            DateTime?
  image                    String?
  plan                     Plan      @default(FREE)
  trialEndsAt              DateTime?
  stripeCustomerId         String?   @unique
  stripePriceId            String?
  stripeSubscriptionId     String?   @unique
  stripeCurrentPeriodEnd   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  obras     Obra[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Construção Civil Models ─────────────────────────────

model Obra {
  id              String      @id @default(cuid())
  userId          String
  nome            String
  descricao       String?
  endereco        String
  cidade          String
  estado          String
  areaM2          Float?
  orcamentoCentavos Int      @default(0)
  gastoCentavos   Int         @default(0)
  status          ObraStatus  @default(PLANEJAMENTO)
  dataInicio      DateTime?
  dataPrevisaoFim DateTime?
  dataConclusao   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  etapas      Etapa[]
  materiais   ObraMaterial[]
  equipes     ObraEquipe[]
}

model Etapa {
  id              String       @id @default(cuid())
  obraId          String
  nome            String
  descricao       String?
  ordem           Int
  status          EtapaStatus  @default(PENDENTE)
  progresso       Float        @default(0)
  dataInicio      DateTime?
  dataPrevisaoFim DateTime?
  dataConclusao   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

model Material {
  id          String             @id @default(cuid())
  nome        String
  categoria   MaterialCategoria
  unidade     String             // kg, m3, unidade, saco, metro
  precoUnitarioCentavos Int      @default(0)
  descricao   String?

  obraMateriais ObraMaterial[]
}

model ObraMaterial {
  id              String   @id @default(cuid())
  obraId          String
  materialId      String
  quantidade      Float
  quantidadeUsada Float    @default(0)
  custoCentavos   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  obra     Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
}

model Trabalhador {
  id        String   @id @default(cuid())
  nome      String
  funcao    String   // pedreiro, eletricista, encanador, mestre de obras, servente
  telefone  String?
  email     String?
  valorDiaCentavos Int @default(0)
  createdAt DateTime @default(now())

  equipes ObraEquipe[]
}

model ObraEquipe {
  id             String    @id @default(cuid())
  obraId         String
  trabalhadorId  String
  dataEntrada    DateTime  @default(now())
  dataSaida      DateTime?

  obra        Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  trabalhador Trabalhador @relation(fields: [trabalhadorId], references: [id])
}
